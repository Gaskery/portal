# ===============================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ===============================================
DATABASE_URL="postgresql://usuario:senha@localhost:5432/portal_m365?schema=public"

# ===============================================
# NEXTAUTH - AUTENTICAÇÃO
# ===============================================
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ===============================================
# SEGURANÇA
# ===============================================
# Chave de criptografia AES-256 (32 bytes)
# Gerar com: openssl rand -hex 32
ENCRYPTION_KEY="your-encryption-key-32-bytes-minimum-length"

# CSRF Secret
CSRF_SECRET="your-csrf-secret-key"

# ===============================================
# RATE LIMITING (Upstash Redis - Opcional)
# ===============================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ===============================================
# EMAIL (Para envio de notificações)
# ===============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@gmail.com"
SMTP_PASSWORD="sua-senha-app"
SMTP_FROM="noreply@suaempresa.com.br"

# ===============================================
# MONITORAMENTO
# ===============================================
# Sentry (Erro tracking)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ===============================================
# STORAGE (AWS S3 ou similar)
# ===============================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="portal-m365-uploads"

# ===============================================
# AMBIENTE
# ===============================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===============================================
# FEATURES FLAGS
# ===============================================
FEATURE_2FA_ENABLED="true"
FEATURE_EMAIL_NOTIFICATIONS="true"
FEATURE_AUDIT_LOG="true"
